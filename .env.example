# ============================================================================
# Application Configuration
# ============================================================================

# Environment Mode
NODE_ENV=development

# ============================================================================
# Logging Configuration
# ============================================================================

# Log Level: error, warn, info, debug (default: info)
LOG_LEVEL=info

# ============================================================================
# Prisma AIRS API Configuration (Optional)
# ============================================================================

PRISMA_AIRS_TSG_ID=your_tsg_id_here
PRISMA_AIRS_APP_ID=your_customer_app_id_here
PRISMA_AIRS_APP_NAME=your_portkey_app_name_here

# ============================================================================
# Portkey Configuration
# Hosted LLM gateway (api.portkey.ai) + MCP Gateway (mcp.portkey.ai)
# ============================================================================
PORTKEY_API_KEY=pk-your_portkey_api_key_here
# Guarded key — attach a Portkey config to this key that runs the PANW Prisma AIRS
# input + output guardrail hooks. Guarded (phase3) requests use it; falls back to
# PORTKEY_API_KEY when unset. Enforcing guardrails on the key (not via x-portkey-config
# per request) keeps the guard server-side and out of the app code.
PORTKEY_API_KEY_GUARDED=pk-your_guarded_portkey_api_key_here
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# MCP Gateway — one endpoint per registered server (no single aggregator).
# Register each tools server in the Portkey dashboard and set its slug here.
# Any PORTKEY_MCP_*_SLUG var is auto-wired as an MCP client — add a server by
# adding a var, no code change needed.
PORTKEY_MCP_BASE=https://mcp.portkey.ai
PORTKEY_MCP_HR_SLUG=hr-tools
PORTKEY_MCP_IT_SLUG=it-tools
PORTKEY_MCP_IT_TRIAGE_SLUG=it-triage

# Provider integration slugs — must match the slugs in your Portkey Model Catalog.
# Per-tier model overrides also available: PORTKEY_{AWS,GCP,AZURE}_{FAST,POWERFUL}.
PORTKEY_AWS_PROVIDER=@aws
PORTKEY_GCP_PROVIDER=@gcp
PORTKEY_AZURE_PROVIDER=@azure

# Default provider tier (AWS | GCP | Azure) — used when the frontend sends none.
PORTKEY_DEFAULT_PROVIDER=AWS

# IT triage agent model — use a fast model. The agent runs a multi-step reflect
# loop; a slow model (Sonnet) can exceed the MCP gateway timeout and 502.
IT_TRIAGE_MODEL=@aws/eu.anthropic.claude-haiku-4-5-20251001-v1:0

# IT triage data-tool endpoints. By default the agent consumes hr/it-tools THROUGH the
# Portkey MCP Gateway (slugs above) so Portkey observes every MCP data-tool call — this is
# the demo default. Setting IT_TRIAGE_MCP_URLS points the agent straight at the tools
# servers over the docker network instead (faster, but Portkey no longer sees those calls).
# Escape hatch for latency only; leave unset for the demo.
# IT_TRIAGE_MCP_URLS=http://it-tools-mcp-server:3000/mcp,http://hr-tools-mcp-server:3000/mcp

# Response caching: attach a SIMPLE/exact-match cache config to PORTKEY_API_KEY in the
# Portkey dashboard (a semantic cache can mis-hit mid agent loop and return stale reasoning
# or a stale tool call). Cache and guardrails now ride on the key's config, not per-request
# x-portkey-config headers.

# Tools servers are exposed to Portkey Cloud via a host-level Cloudflare tunnel (managed outside
# compose). Register each hostname (e.g. hr-tools.<domain>/mcp → 127.0.0.1:3017) in the Portkey
# MCP Gateway, then set the returned slugs in PORTKEY_MCP_*_SLUG above.

# COMPOSE_PROJECT_NAME=hr-it-bot-v2