# The Otter demo — environment template. `.env.example` dictates the variables of `.env`:
# after editing it, run `node scripts/sync-env.mjs` to rebuild `.env` (current values are kept).

# --- AI Gateway (SCM AIRS AI Gateway, workspace theotter) ---
# SaaS: https://aigw.portkey.ai/v1 and https://mcp-aigw.portkey.ai
# Local hybrid gateway: http://host.docker.internal:8787/v1 and http://host.docker.internal:8788
PORTKEY_BASE_URL=https://aigw.portkey.ai/v1
PORTKEY_MCP_BASE=https://mcp-aigw.portkey.ai
# Service keys: default (cache + retry) and guarded (AIRS guardrails in + out, phase 3)
PORTKEY_API_KEY=<set-me>
PORTKEY_API_KEY_GUARDED=<set-me>

# --- LLM providers (Portkey integration slugs) ---
PORTKEY_AWS_PROVIDER=@aws
PORTKEY_GCP_PROVIDER=@gcp
PORTKEY_AZURE_PROVIDER=@azure
# Optional per-tier overrides; defaults: Haiku 4.5 (fast) / Sonnet 5.5 (powerful)
PORTKEY_AWS_FAST=
PORTKEY_AWS_POWERFUL=
PORTKEY_GCP_FAST=
PORTKEY_GCP_POWERFUL=
PORTKEY_AZURE_FAST=
PORTKEY_AZURE_POWERFUL=
# Auto (AI Gateway routing): saved config slugs, load balancing + fallback across the three clouds
PORTKEY_AUTO_CONFIG=<set-me>
PORTKEY_AUTO_CONFIG_GUARDED=<set-me>
# Preselected provider: Auto | AWS | GCP | Azure (Auto when PORTKEY_AUTO_CONFIG is set and this is empty)
PORTKEY_DEFAULT_PROVIDER=Auto

# --- MCP servers (one client per PORTKEY_MCP_*_SLUG) ---
PORTKEY_MCP_HR_SLUG=<set-me>
PORTKEY_MCP_IT_SLUG=<set-me>
PORTKEY_MCP_IT_TRIAGE_SLUG=<set-me>

# --- IT triage agent ---
# Model for the triage agent's own loop (default: AWS Sonnet 5.5)
IT_TRIAGE_MODEL=
# Optional: comma-separated direct MCP URLs over the docker network, bypassing the gateway
IT_TRIAGE_MCP_URLS=

# --- Prisma AIRS and gateway deep links (report / trace links in the UI) ---
PRISMA_AIRS_TSG_ID=<set-me>
PRISMA_AIRS_APP_ID=<set-me>
PORTKEY_WORKSPACE_ID=
PORTKEY_DEPLOYMENT_ID=
PORTKEY_ORG_ID=

# --- Misc ---
# Docker Compose project name (container names hr-it-bot-v2-*)
COMPOSE_PROJECT_NAME=hr-it-bot-v2
NODE_ENV=production
LOG_LEVEL=info
