# ============================================================================
# Application Configuration
# ============================================================================

# Environment Mode
NODE_ENV=development

# ============================================================================
# Logging Configuration
# ============================================================================

# Log Level: error, warn, info, debug (default: info)
LOG_LEVEL=info

# ============================================================================
# Prisma AIRS API Configuration (Optional)
# ============================================================================

PRISMA_AIRS_TSG_ID=your_tsg_id_here
PRISMA_AIRS_APP_ID=your_customer_app_id_here
PRISMA_AIRS_APP_NAME=your_portkey_app_name_here

# ============================================================================
# AI Gateway Configuration
#
# Three deployment shapes, same env vars — only the base URLs change:
#   Strata Cloud Manager SaaS  → aigw.portkey.ai/v1      + mcp-aigw.portkey.ai
#   Hybrid (self-hosted)       → <gateway-host>:8787/v1  + <gateway-host>:8788
#   Legacy standalone Portkey  → api.portkey.ai/v1       + mcp.portkey.ai
# ============================================================================
PORTKEY_API_KEY=your_workspace_service_key_here
# Guarded key — attach a gateway config to this key that runs the PANW Prisma AIRS
# input + output guardrail hooks. Guarded (phase3) requests use it; falls back to
# PORTKEY_API_KEY when unset. Enforcing guardrails on the key (not via x-portkey-config
# per request) keeps the guard server-side and out of the app code.
PORTKEY_API_KEY_GUARDED=your_guarded_workspace_service_key_here
PORTKEY_BASE_URL=https://aigw.portkey.ai/v1

# MCP Gateway — one endpoint per registered server (no single aggregator).
# Register each tools server in the gateway, then copy the slug it returns: slugs are
# hash-suffixed and generated server-side, you don't get to choose them.
# Any PORTKEY_MCP_*_SLUG var is auto-wired as an MCP client — add a server by
# adding a var, no code change needed.
PORTKEY_MCP_BASE=https://mcp-aigw.portkey.ai
PORTKEY_MCP_HR_SLUG=hr-tools
PORTKEY_MCP_IT_SLUG=it-tools
PORTKEY_MCP_IT_TRIAGE_SLUG=it-triage

# Observability deep links (trace button, guardrail block link). Not secrets — all of
# these ids are visible in the dashboard URL.
#   SCM:     WORKSPACE_ID + DEPLOYMENT_ID (the `licenseId` in SCM URLs). PRISMA_AIRS_TSG_ID
#            above is also required, otherwise the link lands on the wrong tenant.
#   Portkey: WORKSPACE_ID + ORG_ID instead.
# Leave unset to hide the trace links.
PORTKEY_WORKSPACE_ID=
PORTKEY_DEPLOYMENT_ID=
PORTKEY_ORG_ID=

# Provider integration slugs — must match the slugs in your gateway's Model Catalog.
# Per-tier model overrides also available: PORTKEY_{AWS,GCP,AZURE}_{FAST,POWERFUL}.
PORTKEY_AWS_PROVIDER=@aws
PORTKEY_GCP_PROVIDER=@gcp
PORTKEY_AZURE_PROVIDER=@azure

# Default provider tier (AWS | GCP | Azure) — used when the frontend sends none.
PORTKEY_DEFAULT_PROVIDER=AWS

# IT triage agent model — use a fast model. The agent runs a multi-step reflect
# loop; a slow model (Sonnet) can exceed the MCP gateway timeout and 502.
IT_TRIAGE_MODEL=@aws/eu.anthropic.claude-haiku-4-5-20251001-v1:0

# IT triage data-tool endpoints. By default the agent consumes hr/it-tools THROUGH the
# MCP Gateway (slugs above) so every MCP data-tool call is observed — this is the demo
# default. Setting IT_TRIAGE_MCP_URLS points the agent straight at the tools servers over
# the docker network instead (faster, but those calls are no longer observed).
# Escape hatch for latency only; leave unset for the demo.
# IT_TRIAGE_MCP_URLS=http://it-tools-mcp-server:3000/mcp,http://hr-tools-mcp-server:3000/mcp

# Response caching: attach a SIMPLE/exact-match cache config to PORTKEY_API_KEY in the
# gateway dashboard (a semantic cache can mis-hit mid agent loop and return stale reasoning
# or a stale tool call). Cache and guardrails ride on the key's config, not per-request
# x-portkey-config headers.

# MCP origins. The gateway must reach each tools server, and its control plane only accepts
# publicly-routable hostnames at registration — private IPs are rejected outright.
#   SaaS gateway   → expose each server through a tunnel (e.g. Cloudflare) and register the
#                    public hostname.
#   Hybrid gateway → keep the servers off the internet: register a hostname on a public TLD
#                    that is absent from public DNS, then resolve it locally with
#                    `extra_hosts` on the gateway container (pointing at its docker bridge)
#                    plus TRUSTED_CUSTOM_HOSTS in the gateway env — its SSRF policy blocks
#                    hostnames resolving to private IPs. MCP traffic never leaves the host.

# COMPOSE_PROJECT_NAME=hr-it-bot-v2
